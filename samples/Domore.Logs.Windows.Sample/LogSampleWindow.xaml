<Window x:Class="Domore.Windows.LogSampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Domore.Windows"
        xmlns:logs="clr-namespace:Domore.Windows.Controls;assembly=Domore.Logs.Windows"
        Title="Domore.Logs.Windows sample"
        Width="1100" Height="680" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.Resources>
    <!--
      The control is styled entirely through dependency properties. Entries of
      each severity get their own brush; an unset brush uses Foreground.
    -->
    <Style x:Key="DarkLogStyle" TargetType="logs:LogsControl">
      <Setter Property="Background" Value="#1E1E1E"/>
      <Setter Property="Foreground" Value="#D4D4D4"/>
      <Setter Property="LogDebugForeground" Value="#7F7F7F"/>
      <Setter Property="LogInfoForeground" Value="#9CDCFE"/>
      <Setter Property="LogWarnForeground" Value="#DCDCAA"/>
      <Setter Property="LogErrorForeground" Value="#F48771"/>
      <Setter Property="LogCriticalForeground" Value="#FF4D4D"/>
      <Setter Property="LogSelectionBackground" Value="#55569CD6"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,14,0,4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Opacity" Value="0.7"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock Text="Click a row to select it · Shift-click or drag for a range · Ctrl+C copies · Esc clears · End follows new entries"/>
      </StatusBarItem>
    </StatusBar>
    <ScrollViewer DockPanel.Dock="Left" Width="240" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12,0,12,12">
        <TextBlock Style="{StaticResource Caption}" Text="Entries per second"/>
        <ComboBox ItemsSource="{x:Static local:LogSampleWindow.Rates}"
                  ItemStringFormat="N0" SelectedIndex="2"
                  SelectionChanged="RateBox_SelectionChanged"/>
        <TextBlock Style="{StaticResource Note}"
                   Text="Written on a worker thread. 0 pauses the workload."/>

        <TextBlock Style="{StaticResource Caption}" Text="Threshold"/>
        <ComboBox ItemsSource="{x:Static local:LogSampleWindow.Thresholds}"
                  SelectedItem="{Binding LogThreshold, ElementName=LogView}"/>
        <TextBlock Style="{StaticResource Note}"
                   Text="The lowest severity shown. Entries below it are never formatted."/>

        <TextBlock Style="{StaticResource Caption}" Text="Show only these sources"/>
        <ItemsControl ItemsSource="{x:Static local:LogSampleWindow.Sources}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding}" Checked="Source_Changed" Unchecked="Source_Changed"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Note}"
                   Text="Updates LogNames, an observable collection. None checked shows every source."/>

        <TextBlock Style="{StaticResource Caption}" Text="Line limit"/>
        <ComboBox ItemsSource="{x:Static local:LogSampleWindow.LineLimits}" ItemStringFormat="N0"
                  SelectedItem="{Binding LogLineLimit, ElementName=LogView}"/>
        <TextBlock Style="{StaticResource Note}"
                   Text="The oldest lines are discarded once the limit is reached."/>

        <TextBlock Style="{StaticResource Caption}"
                   Text="{Binding FontSize, ElementName=LogView, StringFormat='Font size {0:0}'}"/>
        <Slider Minimum="9" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding FontSize, ElementName=LogView}"/>
        <CheckBox x:Name="DarkTheme" Content="Dark theme" Margin="0,10,0,0"
                  Checked="DarkTheme_Changed" Unchecked="DarkTheme_Changed"/>

        <TextBlock Style="{StaticResource Caption}" Text="Try"/>
        <Button x:Name="BurstButton" Content="Burst 100,000 entries" Click="Burst_Click"/>
        <Button Content="Log an exception" Click="Exception_Click"/>
        <Button Content="Log Unicode and a long line" Click="Unicode_Click"/>
      </StackPanel>
    </ScrollViewer>
    <logs:LogsControl x:Name="LogView" FontSize="13" BorderThickness="1,0,0,0"
                     BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
  </DockPanel>
</Window>
